<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tcmmall.mapper.RolePermissionMapper">
    <insert id="insert">
        INSERT INTO role_permission (role_id, permission_id) VALUES (#{roleId}, #{permissionId})
    </insert>

    <delete id="deleteByRoleId">
        DELETE FROM role_permission WHERE role_id = #{roleId}
    </delete>

    <select id="selectByRoleId" resultType="com.tcmmall.entity.RolePermission">
        SELECT * FROM role_permission WHERE role_id = #{roleId}
    </select>

    <insert id="batchInsert">
        INSERT INTO role_permission (role_id, permission_id) VALUES
        <foreach collection="permissionIds" item="pid" separator=",">
            (#{roleId}, #{pid})
        </foreach>
    </insert>
</mapper>